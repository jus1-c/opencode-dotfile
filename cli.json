{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "catppuccin-macchiato"
  },
  "plugins": [
    "./plugins/quota",
    "./plugins/goal",
    "./plugins/opencode-mcp-manager",
    "./plugins/vilao-provider",
    "./plugins/opencode-component-updater",
    "./plugins/opencode-mini-session"
  ],
  "diffs": {
    "wrap": "word",
    "view": "auto"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "show",
    "grouping": "auto",
    "image_preview": true,
    "markdown": "rendered",
    "tps": true
  },
  "animations": true,
  "prompt": {
    "paste": "compact",
    "editor": true,
    "image_preview": true
  },
  "debug": {
    "devtools": false
  },
  "keybinds": {
    "agent.cycle": "tab"
  }
}
