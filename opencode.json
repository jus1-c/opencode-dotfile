{
  "$schema": "https://opencode.ai/config.json",
  "snapshot": false,
  "mcp": {
    "log-analyzer": {
      "type": "local",
      "command": [
        "{env:HOME}/.config/opencode/mcps/log-analyzer/.venv/bin/codesdevs-log-analyzer"
      ],
      "enabled": true
    },
    "ghidra-mcp": {
      "type": "local",
      "command": [
        "{env:HOME}/.config/opencode/mcps/ghidra-mcp/bin/ghidra-mcp-launcher"
      ],
      "enabled": true,
      "timeout": 600000
    },
    "disk-forensics": {
      "type": "local",
      "command": [
        "{env:HOME}/.config/opencode/mcps/disk-forensics/.venv/bin/disk-forensics-mcp-server"
      ],
      "enabled": true,
      "timeout": 900000
    },
    "mem-forensics": {
      "type": "local",
      "command": [
        "{env:HOME}/.config/opencode/mcps/mem-forensics/.venv/bin/python",
        "-m",
        "mem_forensics_mcp_server"
      ],
      "enabled": true,
      "timeout": 600000
    },
    "forensics-utils": {
      "type": "local",
      "command": [
        "{env:HOME}/.config/opencode/mcps/forensics-utils/.venv/bin/python",
        "-m",
        "forensics_utils_mcp_server"
      ],
      "enabled": true,
      "timeout": 300000,
      "environment": {
        "VIRUSTOTAL_API_KEY": "{env:VIRUSTOTAL_API_KEY}"
      }
    },
    "windows-forensics": {
      "type": "local",
      "command": [
        "{env:HOME}/.config/opencode/mcps/windows-forensics/.venv/bin/windows-forensics-mcp"
      ],
      "enabled": true,
      "timeout": 300000
    },
    "network-forensics": {
      "type": "local",
      "command": [
        "{env:HOME}/.config/opencode/mcps/network-forensics/.venv/bin/mcp-network-forensics"
      ],
      "enabled": true,
      "timeout": 1800000,
      "environment": {
        "MCP_CASE_ROOT": "/tmp/mcp-network-forensics",
        "TSHARK_PATH": "/usr/sbin/tshark",
        "CAPINFOS_PATH": "/usr/sbin/capinfos",
        "MCP_MAX_FILE_SIZE": "10737418240",
        "MCP_MAX_PACKETS": "10000",
        "MCP_TIMEOUT": "1800",
        "MCP_EXTRACTION_BYTES": "21474836480",
        "MCP_ARTIFACT_BYTES": "52428800",
        "MCP_MAX_CONCURRENT_JOBS": "2",
        "MCP_PLUGIN_MEMORY_BYTES": "2147483648",
        "MCP_NAME_RESOLUTION": "false"
      }
    },
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp",
        "--api-key",
        "{env:CONTEXT7_API_KEY}"
      ],
      "enabled": true
    },
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true
    },
    "markitdown": {
      "type": "local",
      "command": [
        "{env:HOME}/.config/opencode/mcps/markitdown/.venv/bin/markitdown-mcp"
      ],
      "enabled": true,
      "timeout": 300000
    },
    "frida-game-hacking": {
      "type": "local",
      "command": [
        "{env:FRIDA_PYTHON}",
        "-m",
        "frida_game_hacking_mcp"
      ],
      "enabled": true,
      "timeout": 300000
    },
    "headroom-memory": {
      "type": "local",
      "command": [
        "{env:HOME}/.local/share/uv/tools/headroom-ai/bin/python",
        "-m",
        "headroom.memory.mcp_server",
        "--db",
        "{env:HOME}/.headroom/memory.db",
        "--user",
        "{env:USER}"
      ],
      "enabled": true
    },
    "anysearch": {
      "type": "remote",
      "url": "https://api.anysearch.com/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:ANYSEARCH_BEARER}",
        "X-Anysearch-Client": "mcp/1.0.0"
      },
      "timeout": 300000
    },
    "cloakbrowser": {
      "type": "local",
      "command": [
        "/usr/sbin/node",
        "{env:HOME}/.config/opencode/mcps/cloakbrowser/bin/launcher.js"
      ],
      "enabled": true,
      "timeout": 300000,
      "environment": {
        "PLAYWRIGHT_MCP_HEADLESS": "false",
        "PLAYWRIGHT_MCP_OUTPUT_DIR": "/tmp/opencode/cloakbrowser-artifacts",
        "PLAYWRIGHT_MCP_USER_DATA_DIR": "{env:HOME}/.local/state/opencode/cloakbrowser-profile"
      }
    },
    "headroom-ctl": {
      "type": "local",
      "command": [
        "/usr/sbin/node",
        "{env:HOME}/.config/opencode/mcps/headroom-ctl/bin/headroom-ctl.js"
      ],
      "enabled": true
    }
  },
  "plugin": [
    "file://{env:HOME}/.config/opencode/plugins/quota",
    "file://{env:HOME}/.config/opencode/plugins/caveman/plugin.js",
    "file://{env:HOME}/.config/opencode/plugins/headroom/dist/entry.opencode.js",
    "file://{env:HOME}/.config/opencode/plugins/headroom-ctl/plugin.ts",
    "file://{env:HOME}/.config/opencode/plugins/goal/node_modules/@prevalentware/opencode-goal-plugin",
    "file://{env:HOME}/.config/opencode/plugins/llmgate-provider",
    "file://{env:HOME}/.config/opencode/plugins/ponytail/node_modules/@dietrichgebert/ponytail",
    "file://{env:HOME}/.config/opencode/plugins/rtk/plugin.ts",
    "file://{env:HOME}/.config/opencode/plugins/opencode-pty/node_modules/opencode-pty",
    "file://{env:HOME}/.config/opencode/plugins/opencode-dir/node_modules/opencode-dir",
    "file://{env:HOME}/.config/opencode/plugins/opencode-md-table-formatter/node_modules/@franlol/opencode-md-table-formatter",
    "file://{env:HOME}/.config/opencode/plugins/vilao-provider",
    "file://{env:HOME}/.config/opencode/plugins/superpowers/.opencode/plugins/superpowers.js",
    "file://{env:HOME}/.config/opencode/plugins/taste-skill"
  ],
  "permission": {
    "bash": "allow",
    "external_directory": "allow"
  },
  "shell": "/bin/zsh",
  "provider": {
    "openai": {},
    "vilao": {},
