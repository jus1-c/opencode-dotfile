{
  "$schema": "https://opencode.ai/config.json",
  "snapshots": false,
  "update": "auto",
  "mcp": {
    "servers": {
      "log-analyzer": {
        "type": "local",
        "command": [
          "{env:HOME}/.config/opencode/mcps/log-analyzer/.venv/bin/codesdevs-log-analyzer"
        ],
        "disabled": false
      },
      "ghidra-mcp": {
        "type": "local",
        "command": [
          "{env:HOME}/.config/opencode/mcps/ghidra-mcp/bin/ghidra-mcp-launcher"
        ],
        "timeout": {
          "startup": 600000,
          "catalog": 600000,
          "execution": 600000
        },
        "disabled": false
      },
      "disk-forensics": {
        "type": "local",
        "command": [
          "{env:HOME}/.config/opencode/mcps/disk-forensics/.venv/bin/disk-forensics-mcp-server"
        ],
        "timeout": {
          "startup": 900000,
          "catalog": 900000,
          "execution": 900000
        },
        "disabled": false
      },
      "mem-forensics": {
        "type": "local",
        "command": [
          "{env:HOME}/.config/opencode/mcps/mem-forensics/.venv/bin/python",
          "-m",
          "mem_forensics_mcp_server"
        ],
        "timeout": {
          "startup": 600000,
          "catalog": 600000,
          "execution": 600000
        },
        "disabled": false
      },
      "forensics-utils": {
        "type": "local",
        "command": [
          "{env:HOME}/.config/opencode/mcps/forensics-utils/.venv/bin/python",
          "-m",
          "forensics_utils_mcp_server"
        ],
        "timeout": {
          "startup": 300000,
          "catalog": 300000,
          "execution": 300000
        },
        "environment": {
          "VIRUSTOTAL_API_KEY": "{env:VIRUSTOTAL_API_KEY}"
        },
        "disabled": false
      },
      "windows-forensics": {
        "type": "local",
        "command": [
          "{env:HOME}/.config/opencode/mcps/windows-forensics/.venv/bin/windows-forensics-mcp"
        ],
        "timeout": {
          "startup": 300000,
          "catalog": 300000,
          "execution": 300000
        },
        "disabled": false
      },
      "network-forensics": {
        "type": "local",
        "command": [
          "{env:HOME}/.config/opencode/mcps/network-forensics/.venv/bin/mcp-network-forensics"
        ],
        "timeout": {
          "startup": 1800000,
          "catalog": 1800000,
          "execution": 1800000
        },
        "environment": {
          "MCP_CASE_ROOT": "/tmp/mcp-network-forensics",
          "TSHARK_PATH": "/usr/sbin/tshark",
          "CAPINFOS_PATH": "/usr/sbin/capinfos",
          "MCP_MAX_FILE_SIZE": "10737418240",
          "MCP_MAX_PACKETS": "10000",
          "MCP_TIMEOUT": "1800",
          "MCP_EXTRACTION_BYTES": "21474836480",
          "MCP_ARTIFACT_BYTES": "52428800",
          "MCP_MAX_CONCURRENT_JOBS": "2",
          "MCP_PLUGIN_MEMORY_BYTES": "2147483648",
          "MCP_NAME_RESOLUTION": "false"
        },
        "disabled": false
      },
      "context7": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@upstash/context7-mcp",
          "--api-key",
          "{env:CONTEXT7_API_KEY}"
        ],
        "disabled": false
      },
      "markitdown": {
        "type": "local",
        "command": [
          "{env:HOME}/.config/opencode/mcps/markitdown/.venv/bin/markitdown-mcp"
        ],
        "timeout": {
          "startup": 300000,
          "catalog": 300000,
          "execution": 300000
        },
        "disabled": false
      },
      "frida-game-hacking": {
        "type": "local",
        "command": [
          "{env:FRIDA_PYTHON}",
          "-m",
          "frida_game_hacking_mcp"
        ],
        "timeout": {
          "startup": 300000,
          "catalog": 300000,
          "execution": 300000
        },
        "disabled": true
      },
      "anysearch": {
        "type": "remote",
        "url": "https://api.anysearch.com/mcp",
        "headers": {
          "Authorization": "Bearer {env:ANYSEARCH_BEARER}",
          "X-Anysearch-Client": "mcp/1.0.0"
        },
        "timeout": {
          "startup": 300000,
          "catalog": 300000,
          "execution": 300000
        },
        "disabled": false
      },
      "agent-browser": {
        "type": "local",
        "command": [
          "node",
          "{env:HOME}/.config/opencode/mcps/agent-browser/runtime/node_modules/agent-browser/bin/agent-browser.js",
          "mcp"
        ],
        "timeout": {
          "startup": 300000,
          "catalog": 300000,
          "execution": 300000
        },
        "disabled": false
      },
      "github": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:GITHUB_TOKEN}",
          "X-MCP-Toolsets": "default,actions"
        },
        "timeout": {
          "startup": 300000,
          "catalog": 300000,
          "execution": 300000
        },
        "disabled": false
      },
      "codegraph": {
        "type": "local",
        "command": [
          "codegraph",
          "serve",
          "--mcp"
        ],
        "disabled": false,
        "codemode": false
      }
    }
  },
  "plugins": [
    "./plugins/quota",
    "./plugins/caveman",
    "./plugins/goal",
    "./plugins/ponytail",
    "./plugins/superpowers",
    "./plugins/rtk",
    "./plugins/opencode-dir",
    "./plugins/opencode-mcp-manager",
    "./plugins/opencode-pty",
    "./plugins/vilao-provider",
    "./plugins/llmgate-provider",
    "./plugins/prompt-attachment-guard"
  ],
  "permissions": [
    {
      "action": "shell",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "allow"
    }
  ],
  "shell": "/bin/zsh",
