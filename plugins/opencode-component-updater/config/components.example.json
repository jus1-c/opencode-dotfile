{
  "schemaVersion": 2,
  "defaults": {
    "checkIntervalHours": 24,
    "checkTimeoutMs": 60000,
    "updateTimeoutMs": 1800000,
    "maxOutputBytes": 65536,
    "checkConcurrency": 16,
    "stageConcurrency": 8,
    "archiveConcurrency": 4
  },
  "components": {
    "mcp.example": {
      "target": "/tmp/example-home/.config/opencode/mcps/example",
      "enabled": false,
      "source": {
        "type": "git",
        "url": "https://github.com/example/server.git",
        "path": "source",
        "track": "release"
      }
    }
  }
}
