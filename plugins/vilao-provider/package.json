{
  "name": "opencode-vilao-provider",
  "version": "0.1.0",
  "description": "Vilao provider for OpenCode with subscription-aware model discovery.",
  "type": "module",
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "exports": {
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js"
    }
  },
  "oc-plugin": [
    "server",
    "tui"
  ],
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc && node scripts/prepare-tui-dist.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "peerDependencies": {
    "@opencode-ai/plugin": "^1.18.30"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-typescript": "^7.27.1",
    "@opencode-ai/plugin": "1.18.30",
    "@opencode-ai/sdk": "^1.18.0",
    "@opentui/core": "^0.4.3",
    "@opentui/solid": "^0.4.3",
    "@types/node": "^22.0.0",
    "babel-preset-solid": "^1.9.12",
    "solid-js": "^1.9.12",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "opencode": ">=1.18.0"
  },
  "license": "MIT"
}
